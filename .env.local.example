# ==============================================================================
# Neon Serverless PostgreSQL Database Connection
# ==============================================================================
# To enable cloud synchronization between your workstations, create a free database
# at https://neon.tech, copy the connection string, and create a .env.local file:
#
# DATABASE_URL=postgres://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
#
# If no DATABASE_URL is configured, the application operates in 100% Local Mode,
# safely saving all tasks, templates, and notes directly in your browser's localStorage.
# ==============================================================================

DATABASE_URL=
